<?xml version="1.0" encoding="utf-8"?>
<!--
  Circa Clock (clock/README.md): the round Clock app replacing DeskClock. Platform-signed priv-app on
  /product. Alarms are WATCH-LOCAL: no phone alarm is read, imported or mirrored; no INTERNET.
  Direct boot aware: alarms live in device-protected storage and ring before the first unlock.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Exact alarms for an alarm-clock app (normal permission, no user prompt). -->
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- The ringing activity may be started from the background service (privapp-permissions-circa.xml). -->
    <uses-permission android:name="android.permission.START_ACTIVITIES_FROM_BACKGROUND" tools:ignore="ProtectedPermissions" />
    <!-- The crown press reaches the ringing screen (it dismisses) instead of going Home (privapp-permissions-circa.xml). -->
    <uses-permission android:name="android.permission.OVERRIDE_SYSTEM_KEY_BEHAVIOR_IN_FOCUSED_WINDOW" tools:ignore="ProtectedPermissions" />

    <application
        android:allowBackup="false"
        android:directBootAware="true"
        android:icon="@drawable/ic_clock"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.CircaClock">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:directBootAware="true"
            android:launchMode="singleTask"
            android:taskAffinity="org.circa.clock"
            android:configChanges="locale|layoutDirection|fontScale|fontWeightAdjustment|density"
            android:screenOrientation="nosensor">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- AlarmClock intents. Priority 100 beats DeskClock (system apps only; see settings.md "Testing notes"). -->
            <intent-filter android:priority="100">
                <action android:name="android.intent.action.SET_ALARM" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <intent-filter android:priority="100">
                <action android:name="android.intent.action.SHOW_ALARMS" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <intent-filter android:priority="100">
                <action android:name="android.intent.action.SET_TIMER" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <intent-filter android:priority="100">
                <action android:name="android.intent.action.SHOW_TIMERS" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- Over the lock screen, screen turned on; its own task so it never shows in Recents. -->
        <activity
            android:name=".RingActivity"
            android:exported="false"
            android:directBootAware="true"
            android:launchMode="singleInstance"
            android:taskAffinity=""
            android:excludeFromRecents="true"
            android:showWhenLocked="true"
            android:turnScreenOn="true"
            android:configChanges="locale|layoutDirection|fontScale|fontWeightAdjustment|density"
            android:screenOrientation="nosensor"
            tools:ignore="UnusedAttribute" />

        <service
            android:name=".data.RingService"
            android:exported="false"
            android:directBootAware="true"
            android:foregroundServiceType="mediaPlayback" />

        <receiver
            android:name=".data.ClockReceiver"
            android:exported="true"
            android:directBootAware="true">
            <intent-filter>
                <action android:name="android.intent.action.LOCKED_BOOT_COMPLETED" />
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
