<?xml version="1.0" encoding="utf-8"?>
<!--
  Circa Exercise (exercise/README.md): workouts with HR zones, GPS distance/pace/route, calories, and a
  sync provider WatchLink serves to Gadgetbridge. Platform-signed system app. No INTERNET.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_HEALTH" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <!-- Heart rate: BODY_SENSORS up to Android 15, the granular health permission from Android 16 (API 36). -->
    <uses-permission android:name="android.permission.BODY_SENSORS" android:maxSdkVersion="35" />
    <uses-permission android:name="android.permission.health.READ_HEART_RATE" />
    <uses-permission android:name="android.permission.ACTIVITY_RECOGNITION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- The side button (KEYCODE_STEM_PRIMARY) reaches the focused window first: pause/resume while recording
         (privapp-permissions; exercise/README.md). -->
    <uses-permission android:name="android.permission.OVERRIDE_SYSTEM_KEY_BEHAVIOR_IN_FOCUSED_WINDOW" tools:ignore="ProtectedPermissions" />

    <application
        android:allowBackup="false"
        android:icon="@drawable/ic_exercise"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.CircaExercise">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:taskAffinity="org.circa.exercise"
            android:showWhenLocked="true"
            android:configChanges="locale|layoutDirection|fontScale|fontWeightAdjustment|density|orientation|screenSize"
            android:screenOrientation="nosensor">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Side-button long press (exercise/README.md): a no-UI trampoline
             that decides End offer / list / start-last and hands over to MainActivity. -->
        <activity
            android:name=".LongPressActivity"
            android:exported="true"
            android:theme="@style/Theme.CircaExercise.Trampoline"
            android:taskAffinity="org.circa.exercise"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:showWhenLocked="true"
            android:turnScreenOn="true"
            tools:ignore="UnusedAttribute">
            <intent-filter>
                <action android:name="org.circa.action.EXERCISE_LONG_PRESS" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <service
            android:name=".data.ExerciseService"
            android:exported="false"
            android:foregroundServiceType="health|location" />

        <!-- WatchLink -> Gadgetbridge workout sync; caller-checked in code (system uid or same signature). -->
        <provider
            android:name=".data.SyncProvider"
            android:authorities="org.circa.exercise.sync"
            android:exported="true"
            tools:ignore="ExportedContentProvider" />

        <!-- Emulator aid (fake heart rate). DUMP: only shell / system can send it; ignored on user builds. -->
        <receiver
            android:name=".data.DebugReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP">
            <intent-filter>
                <action android:name="org.circa.exercise.DEBUG_HR" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
